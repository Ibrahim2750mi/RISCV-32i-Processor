    <comp lib="7" loc="(103,759)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Put the clock on  when reset 0-&gt;1-&gt;0"/>
    </comp>
    <comp lib="7" loc="(113,963)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="So, if any instruction doesn't works do contact"/>
    </comp>
    <comp lib="7" loc="(114,806)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="funct3 for jal, lui and auipc are dont care"/>
    </comp>
    <comp lib="7" loc="(119,948)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="assignment are ran and checked manually"/>
    </comp>
    <comp lib="7" loc="(140,778)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="then do clock ticks to run through the instructions"/>
    </comp>
    <comp lib="7" loc="(147,938)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="All the instructions that were provided, in the verilog"/>
    </comp>
    <comp lib="7" loc="(151,795)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="It is a 2 cycle, fetch state and execute state, processor"/>
    </comp>
    <comp lib="7" loc="(161,893)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="This processor is implemented totally by reading the docs"/>
    </comp>
    <comp lib="7" loc="(162,822)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="similarly funct7 we only care about funct7 in Rtype and slli"/>
    </comp>
    <comp lib="7" loc="(165,909)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="provided in the help menu on top left, following my verilog"/>
    </comp>
    <comp lib="7" loc="(170,701)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="then set to 0 again"/>
    </comp>
    <comp lib="7" loc="(199,686)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="set to 1 to reset the processor"/>
    </comp>
    <comp lib="7" loc="(205,593)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="cycle 1"/>
    </comp>
    <comp lib="7" loc="(208,623)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="tick 2: off -&gt; on"/>
    </comp>
    <comp lib="7" loc="(208,657)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="tick 4: off -&gt; on"/>
    </comp>
    <comp lib="7" loc="(209,611)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="tick 1: on -&gt; off"/>
    </comp>
    <comp lib="7" loc="(209,634)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="cycle 2"/>
    </comp>
    <comp lib="7" loc="(209,645)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="tick 3: on -&gt; off"/>
    </comp>
    <comp lib="7" loc="(37,836)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="srli and srai"/>
    </comp>
    <comp lib="7" loc="(48,923)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="rv 32i processor"/>
    </comp>
